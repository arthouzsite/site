# Runtime: development | test | production. The session cookie is Secure only when this is production.
NODE_ENV=development
# PostgreSQL connection string (PostgreSQL 16+ with the pg_trgm extension). Secret.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arthouz
# Direct (non-pooled) connection for `prisma migrate`; optional, falls back to DATABASE_URL. Neon: drop the "-pooler" host suffix.
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/arthouz
# Database used by the API integration tests; the suite truncates every table.
DATABASE_URL_TEST=postgresql://manoranjith@localhost:5433/arthouz_next_test
# Signs the ah_session cookie; at least 32 characters. Secret.
JWT_SECRET=change-me-to-at-least-32-random-characters
# Public origin of this site, no trailing slash (canonical URLs, sitemap, robots, CSRF origin check).
NEXT_PUBLIC_SITE_URL=http://localhost:3300
# Host of AWS_S3_PUBLIC_URL (R2 public bucket), e.g. media.example.com. Needed for next/image to load bucket images. Optional.
IMAGE_HOST=
# Shared secret for POST /api/revalidate (x-revalidate-secret header). Secret. (removed in Task 9 with the revalidate webhook)
REVALIDATE_SECRET=change-me
# Base URL the site fetches content from. Temporary HTTP bridge to the old API; removed in Task 9.
API_URL=http://localhost:4200
# Media storage: r2 (S3-compatible bucket) or memory (nothing persisted, memory:// URLs).
STORAGE_DRIVER=memory
# S3 API endpoint of the bucket, e.g. https://<account-id>.r2.cloudflarestorage.com (required for r2).
# S3_ENDPOINT=
# Bucket access key id (required for r2). Secret.
# AWS_ACCESS_KEY_ID=
# Bucket secret access key (required for r2). Secret.
# AWS_SECRET_ACCESS_KEY=
# Bucket name (required for r2).
# AWS_S3_BUCKET_NAME=
# Public base URL of the bucket, no trailing slash (required for r2); stored image URLs are built from it.
# AWS_S3_PUBLIC_URL=
# Email of the admin user created by `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
# Password of the seeded admin user. Secret.
SEED_ADMIN_PASSWORD=change-me

# --- Test harness only (never set in deployments) ---
# Freezes "today" (YYYY-MM-DD) for exhibition status and the footer year; applies under `next start` only with ALLOW_TEST_OVERRIDES=1.
# TODAY_OVERRIDE=
# 1 serves images unoptimised; ignored when NODE_ENV=production unless ALLOW_TEST_OVERRIDES=1.
# NEXT_IMAGE_UNOPTIMIZED=
# 1 lets TODAY_OVERRIDE and NEXT_IMAGE_UNOPTIMIZED apply under `next start`.
# ALLOW_TEST_OVERRIDES=
# Visual harness (`pnpm test:visual`), read from this file or the shell:
# Database the harness migrates and seeds. Default: postgresql://<os user>@localhost:5433/arthouz_test_web
# VISUAL_DATABASE_URL=
# Ports of the harness API and web servers. Defaults: 4100 and 3100.
# VISUAL_API_PORT=
# VISUAL_WEB_PORT=
# Use already running servers at these URLs for the comparison instead of the default localhost ports.
# VISUAL_API_URL=
# VISUAL_PORT_URL=
# 1 writes prototype/port/diff PNGs for passing cases too.
# VISUAL_WRITE_ALL=
