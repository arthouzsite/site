{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "app", "components", "hooks", "lib", "admin", "tests", "prisma", "*.ts", "*.mjs", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["apps", "packages", "node_modules", ".next/cache", "lib/server/generated", "tests/visual/reference", "test-results"]
}
