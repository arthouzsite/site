# Build-time (Vite): values are baked into the bundle, so rebuild after changing them.
# Base URL of the API, no trailing slash. Default: http://localhost:4100
VITE_API_URL=http://localhost:4100
# Public site origin, no trailing slash; builds the "view on site" links of exhibitions. Default: http://localhost:3100
VITE_WEB_URL=http://localhost:3100
# URL opened by the sidebar's public-site link. Default: /
VITE_PUBLIC_SITE_URL=http://localhost:3100

# --- Test harness only (never set in deployments) ---
# Admin Playwright suite (`pnpm --filter @arthouz/admin test:e2e`), read from the shell:
# Database the suite drops and re-migrates. Default: postgresql://<os user>@localhost:5433/arthouz_test_e2e
# E2E_DATABASE_URL=
# Ports of the suite's API, web and admin servers. Defaults: 4102, 3102, 5182.
# E2E_API_PORT=
# E2E_WEB_PORT=
# E2E_ADMIN_PORT=
