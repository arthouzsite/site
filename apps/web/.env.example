# Base URL of the Art Houz API (apps/api), read at runtime on the server.
API_URL=http://localhost:4100
# Shared secret the API sends in x-revalidate-secret; must equal apps/api REVALIDATE_SECRET. Secret.
REVALIDATE_SECRET=change-me
# Public origin of this site, no trailing slash (canonical URLs, sitemap, robots). Default: http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Host of apps/api AWS_S3_PUBLIC_URL (R2 public bucket), e.g. media.example.com. Needed for next/image to load bucket images. Optional.
IMAGE_HOST=

# --- Test harness only (never set in deployments) ---
# Footer year override (YYYY-MM-DD); applies under `next start` only with ALLOW_TEST_OVERRIDES=1.
# TODAY_OVERRIDE=
# 1 serves images unoptimised; ignored when NODE_ENV=production unless ALLOW_TEST_OVERRIDES=1.
# NEXT_IMAGE_UNOPTIMIZED=
# 1 lets TODAY_OVERRIDE and NEXT_IMAGE_UNOPTIMIZED apply under `next start`.
# ALLOW_TEST_OVERRIDES=
# Visual harness (`pnpm --filter @arthouz/web test:visual`), read from this file or the shell:
# Database the harness migrates and seeds. Default: postgresql://<os user>@localhost:5433/arthouz_test_web
# VISUAL_DATABASE_URL=
# Ports of the harness API and web servers. Defaults: 4100 and 3100.
# VISUAL_API_PORT=
# VISUAL_WEB_PORT=
# Use already running servers at these URLs for the comparison instead of the default localhost ports.
# VISUAL_API_URL=
# VISUAL_PORT_URL=
# 1 writes prototype/port/diff PNGs for passing cases too.
# VISUAL_WRITE_ALL=
# JWT_SECRET is also read from the shell by playwright.config.ts for the harness API (default is built in).
