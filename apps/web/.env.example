# Base URL of the Art Houz API (apps/api).
API_URL=http://localhost:4100
# Shared secret the API sends in x-revalidate-secret; must equal apps/api REVALIDATE_SECRET.
REVALIDATE_SECRET=change-me
# Public origin of this site.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Set to 1 to serve images unoptimised (ignored when NODE_ENV=production).
NEXT_IMAGE_UNOPTIMIZED=
# Host of AWS_S3_PUBLIC_URL (R2 public bucket), e.g. media.example.com. Optional.
IMAGE_HOST=
