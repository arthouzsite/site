{
  "name": "@arthouz/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "pretest:e2e": "pnpm -w build:shared && prisma generate",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@arthouz/shared": "workspace:^",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "jest": "^30",
    "prisma": "^7",
    "supertest": "^7.3.1",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
