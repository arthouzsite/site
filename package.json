{
  "name": "arthouz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 5174",
    "build": "next build",
    "start": "next start --port 5174",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test visual/",
    "test:a11y": "playwright test a11y/",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "media:rehome": "tsx --conditions=react-server prisma/rehome-media.ts",
    "media:relink": "tsx --conditions=react-server prisma/relink-media.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:visual && pnpm test:a11y && pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@hookform/resolvers": "^6.0.2",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "argon2": "^0.45.1",
    "jose": "^6.2.14",
    "next": "^16",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prisma": "^7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
