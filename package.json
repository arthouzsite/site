{
  "name": "arthouz",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm build:shared && pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "build:shared": "pnpm --filter @arthouz/shared build",
    "test:coverage": "pnpm --filter @arthouz/shared --filter @arthouz/web --filter @arthouz/admin --workspace-concurrency=1 test:coverage && pnpm --filter @arthouz/api test:cov",
    "test:e2e": "pnpm --filter @arthouz/web test:e2e && pnpm --filter @arthouz/admin test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:e2e"
  }
}
